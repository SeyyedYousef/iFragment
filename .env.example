# ============================================
# iFragment Production Environment Variables
# ============================================
# Copy this file to .env and fill in ALL values before deploying.
# This file must be placed next to docker-compose.prod.yml

# ─── Server ───────────────────────────────
APP_ENV=production
PORT=8080

# ─── Security (REQUIRED - Generate strong random values) ───
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS
WEBHOOK_SECRET_TOKEN=CHANGE_ME_TO_A_RANDOM_STRING
BOT_TOKEN_KEY=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING

# ─── Telegram Bot (REQUIRED) ──────────────
BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# ─── Telegram MTProto (Optional - for advanced features) ───
TG_APP_ID=
TG_APP_HASH=

# ─── Database (Used by docker-compose) ────
POSTGRES_USER=ifragment_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=ifragment

# ─── External API Keys ───────────────────
TONAPI_KEY=your_tonapi_key_here
MARKETAPP_TOKEN=your_marketapp_token_here
TONAPI_WEBHOOK_SECRET=your_tonapi_webhook_secret
TON_RECIPIENT_WALLET=your_ton_wallet_address

# ─── CORS (comma-separated origins) ──────
ALLOWED_ORIGINS=https://tgfirewall.xyz

# ─── App URL (for webhook registration) ──
APP_URL=https://api.tgfirewall.xyz

# ─── Monitoring (Optional) ───────────────
SENTRY_DSN=
METRICS_TOKEN=CHANGE_ME_TO_A_RANDOM_STRING

# ─── Admin Panel ─────────────────────────
OWNER_TELEGRAM_IDS=
OWNER_TOTP_SECRET=

# ─── Security Hardening ──────────────────
TRUSTED_PROXIES=

# ─── Feature Flags ───────────────────────
FEATURE_FLAG_FORWARDING=true
FEATURE_FLAG_AUTORESPONDER=true
