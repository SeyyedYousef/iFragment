# ============================================================================
# iFragment — Production Environment Variables (v2.0)
# ============================================================================
# Copy this file to .env and fill in ALL values before deploying.
# This file must be placed next to docker-compose.prod.yml

# ─── Server & Runtime ────────────────────────
APP_ENV=production
PORT=8080
IFRAGMENT_ALLOW_UNPAID_REPORTS=false
IFRAGMENT_PRICING_MODEL_URL=

# ─── Security (REQUIRED — Generate with: openssl rand -hex 32) ───
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS
WEBHOOK_SECRET_TOKEN=CHANGE_ME_TO_A_RANDOM_STRING
BOT_TOKEN_KEY=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING
CERTIFICATE_SIGNING_KEY=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING

# ─── Telegram Bot & Mini App (REQUIRED) ──────
BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
MINI_APP_URL=https://t.me/iFragmentBot/app

# ─── Telegram MTProto (Optional — for live NFT / profile resolution) ───
TG_APP_ID=
TG_APP_HASH=

# ─── Database (PostgreSQL 17) ────────────────
POSTGRES_USER=ifragment_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=ifragment
DATABASE_URL=postgres://ifragment_user:CHANGE_ME_TO_A_STRONG_PASSWORD@db:5432/ifragment?sslmode=disable

# ─── Cache (DragonflyDB / Redis) ─────────────
DRAGONFLY_URL=redis://dragonfly:6379/0
DRAGONFLY_MAX_MEMORY=256MB

# ─── CORS & Public URLs ──────────────────────
ALLOWED_ORIGINS=https://ifragment.app
APP_URL=https://api.ifragment.app
BACKEND_URL=https://api.ifragment.app

# ─── External Blockchain & Market APIs ───────
TONAPI_KEY=your_tonapi_key_here
MARKETAPP_TOKEN=your_marketapp_token_here
TONAPI_WEBHOOK_SECRET=your_tonapi_webhook_secret
TON_RECIPIENT_WALLET=your_ton_wallet_address

# ─── Laya System 1 AI Decision Engine (Optional Sidecar) ───
LAYA_BASE_URL=http://localhost:8000/v1/systemone
LAYA_API_KEY=
LAYA_MODEL=convai/laya-multilingual

# ─── Intel Credit Store & Economy (Telegram Stars XTR) ───
COINS_PER_CREDIT=150000
CREDIT_PACK_1_STARS=100
CREDIT_PACK_3P1_STARS=250
CREDIT_PACK_10P3_STARS=800
CREDIT_BATCH_EXPIRY_DAYS=0

# ─── @TheGramPrice Live Channel Broadcaster ───
GRAM_CHANNEL_ID=@TheGramPrice

# ─── Owner Super-Panel & Admin Topic Notifications ───
OWNER_TELEGRAM_IDS=123456789,987654321
OWNER_PASSWORD=CHANGE_ME_TO_A_SECURE_ADMIN_PASSWORD
OWNER_TOTP_SECRET=
ADMIN_GROUP_ID=
ADMIN_TOPIC_AVM=
ADMIN_TOPIC_GIFTS=
ADMIN_TOPIC_NUMBERS=
ADMIN_TOPIC_PAYMENTS=
ADMIN_TOPIC_NEW_BOT=
ADMIN_TOPIC_NEW_CHANNEL=
ADMIN_TOPIC_SYSTEM=

# ─── Observability & Security Hardening ──────
SENTRY_DSN=
METRICS_TOKEN=CHANGE_ME_TO_A_RANDOM_STRING
TRUSTED_PROXIES=
