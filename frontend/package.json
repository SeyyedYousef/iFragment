    "@tanstack/solid-query": "^5.100.1",
    "@tma.js/sdk-solid": "^3.0.8",
    "@tonconnect/ui": "^2.0.5",
    "eruda": "^3.0.1",
    "solid-focus-trap": "^0.1.9",
    "solid-js": "^1.9.9",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
