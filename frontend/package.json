    "eslint-plugin-solid": "^0.14.0",
    "gh-pages": "^6.1.1",
    "globals": "^15.2.0",
    "knip": "^6.6.3",
    "lefthook": "^2.1.6",
    "msw": "^2.13.6",
    "solid-devtools": "^0.30.1",
    "tailwindcss": "^4.2.4",
