  "version": "0.0.2",
  "type": "module",
  "main": "index.js",
  "homepage": "https://ifragment.app",
  "scripts": {
    "deploy": "gh-pages -d dist",
    "dev": "vite",
    "dev:https": "cross-env HTTPS=true vite",
