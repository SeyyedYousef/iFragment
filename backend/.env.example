# iFragment Backend Configuration

# Server
PORT=8080
APP_ENV=development
IFRAGMENT_ALLOW_UNPAID_REPORTS=false
IFRAGMENT_PRICING_MODEL_URL=

# Security (REQUIRED for production - generate with: openssl rand -hex 32)
JWT_SECRET=dev_jwt_secret_change_in_production_32chars
WEBHOOK_SECRET_TOKEN=dev_webhook_secret_change_in_production
BOT_TOKEN_KEY=dev_bot_token_key_32_characters_

# Telegram
BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram MTProto (Optional)
TG_APP_ID=
TG_APP_HASH=

# Database
DATABASE_URL=postgres://user:password@localhost:5432/ifragment?sslmode=disable

# Cache
DRAGONFLY_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App URL (used for webhook registration)
APP_URL=http://localhost:8080

# API Keys
TONAPI_KEY=your_tonapi_key_here
MARKETAPP_TOKEN=your_marketapp_token_here
TONAPI_WEBHOOK_SECRET=
TON_RECIPIENT_WALLET=

# Monitoring (Optional)
SENTRY_DSN=
METRICS_TOKEN=

# Admin Panel & Notifications
OWNER_TELEGRAM_IDS=
OWNER_TOTP_SECRET=
OWNER_PASSWORD=
ADMIN_GROUP_ID=
ADMIN_TOPIC_AVM=
ADMIN_TOPIC_NEW_BOT=
ADMIN_TOPIC_NEW_CHANNEL=
ADMIN_TOPIC_PAYMENTS=

# Security
TRUSTED_PROXIES=

